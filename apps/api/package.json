{
  "name": "@trastienda/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "node scripts/generate-openapi.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "typebox": "1.3.37"
  },
  "devDependencies": {
    "@scalar/fastify-api-reference": "1.74.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.5",
    "dotenv": "18.0.8",
    "eslint": "10.12.0",
    "eslint-plugin-boundaries": "7.2.0",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
