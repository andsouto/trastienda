{
  "name": "@trastienda/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "node scripts/generate-openapi.ts",
    "provision:idp": "node --env-file-if-exists=../../.env scripts/provision-idp.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@fastify/swagger": "9.9.3",
    "@fastify/type-provider-typebox": "6.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "jose": "6.2.15",
    "typebox": "1.4.4"
  },
  "devDependencies": {
    "@scalar/fastify-api-reference": "1.76.4",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.2",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
