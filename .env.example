# --- API ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://trastienda:trastienda@localhost:5432/trastienda

# --- OIDC (Zitadel from docker compose) ---
OIDC_ISSUER_URL=http://localhost:8080
OIDC_AUDIENCE=trastienda-api

# --- Object storage (MinIO from docker compose) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=trastienda
S3_SECRET_KEY=trastienda-secret
S3_BUCKET=trastienda-media

# --- docker compose only ---
POSTGRES_USER=trastienda
POSTGRES_PASSWORD=trastienda
POSTGRES_DB=trastienda
# must be exactly 32 characters
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
