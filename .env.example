# --- API ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# API reference at http://localhost:3000/docs; development only
API_DOCS=true
# browser origins allowed to call the API, comma-separated: the admin's ng serve
CORS_ORIGINS=http://localhost:4200
DATABASE_URL=postgresql://trastienda:trastienda@localhost:5432/trastienda

# --- OIDC (Zitadel from docker compose) ---
OIDC_ISSUER_URL=http://localhost:8080
# the Zitadel project's ID; process-compose's idp process creates it with this one
OIDC_AUDIENCE=trastienda
# Zitadel types every token JWT, never RFC 9068's at+jwt, so the API refuses ID
# tokens by their claims instead. Leave it out with a provider that types its
# access tokens.
OIDC_TYPED_ACCESS_TOKENS=false

# --- Object storage (MinIO from docker compose) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=trastienda
S3_SECRET_KEY=trastienda-secret
S3_BUCKET=trastienda-media

# --- docker compose only ---
POSTGRES_USER=trastienda
POSTGRES_PASSWORD=trastienda
POSTGRES_DB=trastienda
# must be exactly 32 characters
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
