{
  "name": "trastienda",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && pnpm -r --no-bail lint",
    "lint:fix": "eslint . --fix && pnpm -r --no-bail lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "codegen": "pnpm --filter @trastienda/api run openapi && pnpm --filter @trastienda/admin run codegen"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-unicorn": "77.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
