{
  "name": "trastienda",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && pnpm -r --no-bail lint",
    "lint:fix": "eslint . --fix && pnpm -r --no-bail lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r build",
    "codegen": "pnpm --filter @trastienda/api run openapi && pnpm --filter @trastienda/admin run codegen"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.15.0",
    "eslint-plugin-jsdoc": "65.4.12",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-unicorn": "79.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
