{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":pinAllExceptPeerDependencies"],
  "timezone": "Europe/Madrid",
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "automergeStrategy": "rebase",
  "automerge": true,
  "lockFileMaintenance": {
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Workflow actions move as a block",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "mise.toml is the single source for node, packageManager for pnpm; move them together",
      "matchDepNames": ["node", "pnpm"],
      "groupName": "toolchain"
    },
    {
      "description": "Angular moves as a block",
      "matchPackageNames": [
        "@angular/**",
        "@angular-devkit/**",
        "@schematics/angular",
        "angular-eslint"
      ],
      "groupName": "angular"
    },
    {
      "description": "typescript-eslint moves as a block (it sets the TypeScript ceiling)",
      "matchPackageNames": ["typescript-eslint", "@typescript-eslint/**"],
      "groupName": "typescript-eslint"
    },
    {
      "description": "Zitadel api and login share a tag: they never move apart",
      "matchPackageNames": ["ghcr.io/zitadel/**"],
      "groupName": "zitadel"
    },
    {
      "description": "Angular 22 needs >=6.0 <6.1 and typescript-eslint caps at <6.1; TS 7 is a deliberate move, not a bump",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "A major is a decision, not a chore",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Nothing in CI boots Zitadel and it migrates its schema on start: try it by hand, then merge",
      "matchPackageNames": ["ghcr.io/zitadel/**"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    }
  ]
}
